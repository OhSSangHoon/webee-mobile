# 작물 시세 API (src/features/fruit-price/api 에서 사용)
# 키 발급: https://www.data.go.kr 에서 "katRealTime2" 검색 후 활용 신청
EXPO_PUBLIC_BASE_URL=https://apis.data.go.kr/B552845/katRealTime2/trades2
EXPO_PUBLIC_SERVICE_KEY=

# 기상청 API (src/features/weather/api 에서 사용)
# 키 발급: https://apihub.kma.go.kr 회원가입 후  지상관측 API 신청
# apihub.kma.go.kr/api/typ01/url/kma_sfctm2.php... && kma_sfcdd3.php... 
EXPO_PUBLIC_KMA_API_KEY=

# 농약 검색 API (src/features/pesticide/hooks 에서 사용)
# 키 발급: https://www.nongsaro.go.kr/portal/ps/psn/psnj/openApiLst.ps?menuId=PS65428&pageIndex=1&pageSize=&sLclasCode=&sText=%ED%99%94%EB%B6%84%EB%A7%A4%EA%B0%9C%EA%B3%A4%EC%B6%A9+%EB%86%8D%EC%95%BD%EC%A0%81%EC%9A%A9 농사로 회원가입 후 해당 링크 API 신청
EXPO_PUBLIC_NONGSARO_BASE_URL=http://api.nongsaro.go.kr/service/insectAgchApplc
EXPO_PUBLIC_NONGSARO_API_KEY=

# 카카오맵 API (src/features/bee-map 에서 사용)
# 키 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# Kakao Developers 플랫폼 설정에서 Web 플랫폼으로 사이트 도메인을 추가해야 합니다.
EXPO_PUBLIC_KAKAO_MAP_API_KEY=